class Particle
{  
  float angle1;
  float angle2;
  float rise,run;
  float X,Y,XE,YE;
  Particle(int s){
    X=width/2;
    Y=height/2;
    rise = speedrange(s);
    run = speedrange(s);
    angle1= atan(radians(rise/run));
  }
  void splode(){
    angle1+=1;
    X+=run;
    Y+=rise;
    XE=X+5*run-sqrt(X+Y)*(cos(radians(angle1)));
    YE=Y+5*rise-sqrt(X+Y)*(sin(radians(angle1)));
  }
  void show(){
    blendMode(SCREEN);
    strokeWeight(3);
    stroke(100+4*(abs(rise)+abs(run)),100+4*(abs(rise)+abs(run)),255);
    //stroke((int)(Math.random()*255),(int)(Math.random()*255),(int)(Math.random()*255));
    line(X,Y,XE,YE);
    stroke(100+7*(abs(rise)+abs(run)),100+7*(abs(rise)+abs(run)),255);
    line(X+5*run,Y+5*rise,X+5*run,Y+5*rise);
  }
}
